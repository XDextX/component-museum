{
  "name": "@component-museum/astro",
  "version": "0.1.0",
  "description": "Astro components of the component museum.",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "keywords": [
    "astro-component"
  ],
  "main": "./index.js",
