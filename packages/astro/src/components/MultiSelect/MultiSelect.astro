---
import type { Option } from './types';
import Checkbox from '../Checkbox/Checkbox.astro';
import { Input } from '../Input';

interface Props {
	options: Option[];
	placeholder?: string;
	disabled?: boolean;
	size?: 'sm' | 'md' | 'lg';
	variant?: 'outline' | 'filled' | 'underline';
	state?: 'default' | 'success' | 'error' | 'warning';
	class?: string;
	[key: string]: any;
}

const {
	options = [],
	placeholder = 'Select options',
	disabled = false,
	size = 'md',
	variant = 'outline',
	state = 'default',
	class: className = '',
	...rest
} = Astro.props as Props;

const sizeClass = `multiselect-${size}`;
const variantClass = `multiselect-${variant}`;
const stateClass = state !== 'default' ? `multiselect-${state}` : '';
const finalClass = `multiselect ${sizeClass} ${variantClass} ${stateClass} ${className}`;
const multiSelectId = `multiselect-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={finalClass} data-multiselect-id={multiSelectId} {...rest}>
	<div class='multiselect-input-wrapper'>
		<Input
			type='text'
			class='multiselect-input'
			placeholder={placeholder}
			readonly
			disabled={disabled}
			data-multiselect-display={multiSelectId}
		/>
		<button
			class='multiselect-clear'
			data-multiselect-clear={multiSelectId}
			disabled={disabled}
			aria-label='Clear selection'
			type='button'
		>
			✕
		</button>
		<button
			class='multiselect-toggle'
			data-multiselect-toggle={multiSelectId}
			disabled={disabled}
			aria-label='Toggle options'
			type='button'
		>
			▼
		</button>
	</div>

	<div class='multiselect-dropdown' data-multiselect-dropdown={multiSelectId}>
		{
			options.map((option) => (
				<div class='multiselect-option'>
					<Checkbox
						label={option.label}
						value={option.value}
						disabled={option.disabled}
						data-multiselect-checkbox={multiSelectId}
						data-option-label={option.label}
					/>
				</div>
			))
		}
	</div>
</div>

<script>
	import { MultiSelectController } from './MultiSelectController.mts';
	document.querySelectorAll(`[data-multiselect-id]`).forEach((container) => {
		if (container instanceof HTMLElement) {
			new MultiSelectController(container);
		} else {
			console.warn('⚠️ No se encontró contenedor para multiselect');
		}
	});
</script>
