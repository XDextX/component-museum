---
import type { Column, TableState } from './types';
import TableControls from './TableControls.astro';
import TableHeader from './TableHeader.astro';
import TableBody from './TableBody.astro';
import TablePagination from './TablePagination.astro';

interface Props {
	columns: Column[];
	data: Record<string, any>[];
	pageSize?: number;
	searchable?: boolean;
	filterable?: boolean;
	sortable?: boolean;
	paginated?: boolean;
	striped?: boolean;
	hoverable?: boolean;
	class?: string;
	[key: string]: any;
}

const {
	columns,
	data,
	pageSize = 10,
	searchable = true,
	filterable = true,
	sortable = true,
	paginated = true,
	striped = true,
	hoverable = true,
	class: className = '',
	...rest
} = Astro.props as Props;

const tableId = `table-${Math.random().toString(36).slice(2, 9)}`;

const filterSelectOptions: Record<
	string,
	Array<{ label: string; value: string }>
> = {};

columns.forEach((col) => {
	if (col.filterable) {
		const values = new Set(data.map((row) => String(row[col.key] || '')));
		filterSelectOptions[col.key] = Array.from(values)
			.sort()
			.map((value) => ({ label: value, value }));
	}
});
---

<div
	data-table-id={tableId}
	class={`table-container ${className}`}
	data-data={JSON.stringify(data)}
	data-page-size={pageSize}
	{...rest}
>
	<TableControls
		{tableId}
		{columns}
		{searchable}
		{filterable}
		{filterSelectOptions}
		data-table-controls={tableId}
	/>

	<div class='table-wrapper'>
		<table
			class={`table ${striped ? 'table-striped' : ''} ${hoverable ? 'table-hoverable' : ''}`}
		>
			<TableHeader {tableId} {columns} {sortable} />
			<TableBody {tableId} {columns} data={data.slice(0, pageSize)} />
		</table>
	</div>

	<TablePagination
		{tableId}
		{paginated}
		totalPages={Math.ceil(data.length / pageSize)}
		currentPage={1}
		currentPage={1}
	/>
</div>
<script>
	import { TableController } from './TableController';

	document.querySelectorAll('[data-table-id]').forEach((container) => {
		if (container instanceof HTMLElement) {
			new TableController(container);
		}
	});
</script>
