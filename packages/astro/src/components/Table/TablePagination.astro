---
import Button from '../Button/Button.astro';
import { PAGINATION_ACTION } from './TablePaginationController.mts';

interface Props {
	tableId: string;
	paginated?: boolean;
	totalPages?: number;
	currentPage?: number;
}

const {
	tableId,
	paginated = true,
	totalPages = 1,
	currentPage = 1,
} = Astro.props;
---

{
	paginated && (
		<div
			class='table-pagination'
			data-table-pagination={tableId}
			data-total-pages={totalPages}
			data-current-page={currentPage}
		>
			<Button
				variant='outline'
				size='sm'
				data-pagination-action={tableId}
				data-action={PAGINATION_ACTION.PREV}
				aria-label='Previous page'
			>
				← Previous
			</Button>
			<div class='table-page-info' role='status' aria-live='polite'>
				Page <span data-table-current-page={tableId}>1</span> of
				<span data-table-total-pages={tableId}>{totalPages}</span>
			</div>
			<Button
				variant='outline'
				size='sm'
				data-pagination-action={tableId}
				data-action={PAGINATION_ACTION.NEXT}
				aria-label='Next page'
			>
				Next →
			</Button>
		</div>
	)
}

<script>
	import { TablePaginationController } from './TablePaginationController.mts';

	document.querySelectorAll('[data-table-pagination]').forEach((pagination) => {
		if (pagination instanceof HTMLElement) {
			new TablePaginationController(pagination);
		}
	});
</script>
