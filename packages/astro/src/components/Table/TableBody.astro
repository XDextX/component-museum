---
import type { Column } from './types';

interface Props {
	tableId: string;
	columns: Column[];
	data: Record<string, any>[];
}

const { tableId, columns, data } = Astro.props;
---

<tbody data-table-body={tableId} data-table-columns={JSON.stringify(columns)}>
	{
		data.length === 0 ? (
			<tr>
				<td colspan={columns.length} class='table-empty'>
					No data available
				</td>
			</tr>
		) : (
			data.map((row) => (
				<tr>
					{columns.map(({ key }) => (
						<td class='table-td'>{row[key]}</td>
					))}
				</tr>
			))
		)
	}
</tbody>

<script>
	import { TableBodyController } from './TableBodyController.mts';

	document.querySelectorAll('[data-table-body]').forEach((tbody) => {
		if (tbody instanceof HTMLElement) {
			new TableBodyController(tbody);
		}
	});
</script>
