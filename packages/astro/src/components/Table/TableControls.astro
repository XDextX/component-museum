---
import type { Column } from './types';
import Button from '../Button/Button.astro';
import MultiSelect from '../MultiSelect/MultiSelect.astro';
import { Input } from '../Input';

interface Props {
	tableId: string;
	columns: Column[];
	searchable?: boolean;
	filterable?: boolean;
	filterSelectOptions: Record<string, Array<{ label: string; value: string }>>;
	[key: string]: any;
}

const {
	tableId,
	columns,
	searchable = true,
	filterable = true,
	filterSelectOptions,
	...rest
} = Astro.props;
---

{
	(searchable || filterable) && (
		<div class='table-controls' data-table-controls={tableId} {...rest}>
			<div class='table-controls-top' data-table-controls-top={tableId}>
				{searchable && (
					<Input
						type='search'
						class='table-search-input'
						placeholder='Search...'
						data-table-search={tableId}
						aria-label='Search table data'
					/>
				)}
				{(searchable || filterable) && (
					<Button
						variant='secondary'
						size='sm'
						data-table-clear={tableId}
						title='Clear all filters and search'
					>
						Clear Filters
					</Button>
				)}
			</div>
			{filterable && (
				<div class='table-filters' data-table-filters={tableId}>
					{columns.map((col) =>
						col.filterable ? (
							<div class='table-filter-group'>
								<div class='table-filter-header'>
									<label class='table-filter-label'>{col.label}</label>
								</div>
								<MultiSelect
									options={filterSelectOptions[col.key]}
									placeholder={`Filter by ${col.label}`}
									variant='outline'
									size='sm'
									data-table-filter={tableId}
									data-column={col.key}
								/>
							</div>
						) : null,
					)}
				</div>
			)}
		</div>
	)
}

<script>
	import { ControlsController } from './TableControls';

	document.querySelectorAll('[data-table-controls]').forEach((controls) => {
		if (controls instanceof HTMLElement) {
			new ControlsController(controls);
		}
	});
</script>
