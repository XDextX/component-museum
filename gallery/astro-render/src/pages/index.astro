---
// Every Astro case of every contract whose component the package exports, rendered with the real
// component and extracted by gallery/scripts/extract-astro.mjs (spec 004, RF-5 and RF-6; spec 009, RF-10).
import * as museum from '@component-museum/astro';
import { astroCases, type Contract } from '../../../lib/contract-args.ts';

const found = import.meta.glob('../../../../contracts/*.contract.json', { eager: true, import: 'default' });
const components = museum as unknown as Record<string, any>;
const rendered = (Object.values(found) as Contract[])
  .filter((c) => c.name in components)
  .map((c) => ({ contract: c, Component: components[c.name], slug: c.name.toLowerCase() }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Component cases</title>
  </head>
  <body>
    {
      rendered.map(({ contract, Component, slug }) =>
        astroCases(contract).map(({ id, props: { children, ...props } }) => (
          <div id={`case-${slug}-${id}`}>
            <Component {...props}>{children}</Component>
          </div>
        )),
      )
    }
  </body>
</html>
