---
// Two Textarea whose value needs care, for tests/field-markup.test.ts (spec 010, RF-11): one with HTML
// characters and a line break, one that starts with a line break.
import { Textarea } from '@component-museum/astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Textarea values</title>
  </head>
  <body>
    <Textarea label="Escape" value={'<b>&\nx'} />
    <Textarea label="Newline" value={'\nx'} />
  </body>
</html>
